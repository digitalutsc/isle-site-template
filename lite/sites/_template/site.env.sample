# Site settings for "__SITE__" (bash syntax: KEY=value, quote values with spaces).
# Read by lite/bin/lite-site and lite/intake/*; `make site-render SITE=__SITE__` turns
# them into lite/sites/__SITE__/docker-compose.yml. Edit, then re-render.

# Hostname served by Traefik (*.islandora.io resolves to 127.0.0.1).
SITE_DOMAIN=__SITE__.islandora.io

# The site's Drupal composer project (only config/sync and web/{modules,themes}/custom are
# used; composer.json/composer_site.json/lock come from islandora-lite-site). You clone it
# here yourself, e.g. git clone <internal GitHub URL> lite/sites/__SITE__/repo
SITE_CODE_DIR=lite/sites/__SITE__/repo

# Solr core: dsu_multisite = one core shared by every site, like prod (default);
# __SITE__ = a core of its own.
SITE_SOLR_CORE=dsu_multisite

# Space-separated theme directory names that must exist under lite/sites/__SITE__/themes/
# (you pull them there yourself), e.g. dsu_subtheme_barrioDepartments
SITE_THEMES=

# MySQL database/user name inside db-__SITE__ (also the schema name ibd2sql rewrites to).
SITE_DB_NAME=__SITE__

# Site name shown in Drupal (empty = keep what the database says).
SITE_NAME=

# Production hostname (regex-safe), used for reporting config that still points at prod.
PROD_DOMAIN=

# Tables left empty during .ibd recovery (extended regex, whole-name match). The account
# tables are always skipped: production credentials are never read; the first start copies
# the Lite dev site's accounts instead.
SKIP_TABLES='cache_.*|cachetags|sessions|flood|semaphore|queue|batch|watchdog|advancedqueue|users|users_field_data|users_data|user__roles|user__user_picture|shortcut_set_users'

# Media placeholders at first start: relink = one generic file per media type and every
# file_managed row re-pointed to it (default); per-file = one generated file at each
# original path, database untouched; false = skip (run `make site-placeholders` later).
SITE_PLACEHOLDERS=relink

# InnoDB buffer pool for db-__SITE__ (several sites at once: keep it modest).
SITE_DB_BUFFER_POOL=512M

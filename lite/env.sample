# Islandora Lite defaults for .env (copied by `make lite-init` when .env is missing).
#
# Mirror of upstream sample.env with Lite-specific values. After `make lite-upstream-pull`,
# diff this file against sample.env and port new variables.
#
# Simple string assignment only: no quotes needed, no bash syntax.
COMPOSE_PROJECT_NAME=isle-lite

# Use buildkit when building images.
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# Bind mount consistency (consistent | cached | delegated).
CONSISTENCY=delegated

# The Docker image repository, to push/pull custom images from.
# islandora.io redirects to localhost.
REPOSITORY=islandora.io

# The tag to apply to custom images.
TAG=local

# https://github.com/Islandora-Devops/isle-buildkit tag to use.
# Bump deliberately: a major isle-buildkit bump can change the PHP version.
ISLANDORA_TAG=7.0.18

# islandora.io and *.islandora.io resolve to 127.0.0.1.
DOMAIN=islandora.io

# Set to "on" if your ISLE docker deployment is behind a reverse proxy
REVERSE_PROXY=off

# IPs in front of the Drupal container (real client IP forwarding).
FRONTEND_IP_1=127.0.0.1/32
FRONTEND_IP_2=172.0.0.0/8
FRONTEND_IP_3=192.168.0.0/16

# true for local development (uid remap, dev routers for solr/blazegraph/traefik dashboards).
DEVELOPMENT_ENVIRONMENT=true

# http or https (switch with `make traefik-https-mkcert` / `make traefik-http`).
URI_SCHEME="http"

# self-managed, letsencrypt
TLS_PROVIDER="self-managed"

# Let's Encrypt (production only).
ACME_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_EMAIL=postmaster@example.com

# Production-site replicas (lite/sites/<site>/): `make site-enable SITE=<site>` appends
# the site's compose file to COMPOSE_FILE and its profile to COMPOSE_PROFILES, e.g.
#   COMPOSE_FILE=docker-compose.yml:docker-compose.lite.yml:lite/sites/memory/docker-compose.yml
#   COMPOSE_PROFILES=memory
# Both are managed by make site-enable / site-disable; leave them out otherwise.

# Drupal container healthcheck. The first start installs 844 config files with
# `drush si --existing-config`, so give it time before compose calls it unhealthy.
DRUPAL_HEALTHCHECK_RETRIES=10
DRUPAL_HEALTHCHECK_START_PERIOD=2m
